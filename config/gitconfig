# Set your name and email with the following:
#   git config -f ~/.gitconfig.local user.name "John Appleseed"
#   git config -f ~/.gitconfig.local user.email me@example.com

[include]
path = .gitconfig.local

[color]
ui = auto

[diff]
colorMoved = default

[color "diff"]
commit = yellow reverse

[delta]
minus-style = "#f38ba8" "#411f2a"
minus-emph-style = "#f38ba8" "#692f3d"
plus-style = "#a6e3a1" "#183723"
plus-emph-style = "#a6e3a1" "#2d5f3b"

[init]
defaultBranch = main

[commit]
verbose = true

[core]
excludesfile = ~/.gitignore
attributesfile = ~/.gitattributes
pager = "git-pager"

[interactive]
diffFilter = "git-pager --filter"

[push]
default = tracking

[merge]
log = true
conflictstyle = diff3
tool = vimdiff

[rerere]
enabled = 1

[diff]
compactionHeuristic = true

[difftool "vimdiff"]
cmd = vimdiff $LOCAL $REMOTE

[mergetool]
prompt = false

[rebase]
autosquash = true
autostash = true
instructionFormat = "%s (%an)"

[tag]
sort = version:refname

[git-up "bundler"]
check = true

[git-up "rebase"]
auto = false

[gitflow "branch"]
master = master
develop = develop

[gitflow "prefix"]
feature = feature/
release = release/
hotfix = hotfix/
support = support/
versiontag =

[git-up "rebase"]
arguments = --rebase-merges
