#!/bin/bash
set -euo pipefail

if [ $# != 1 ]; then
  echo "Usage: `basename $0` <primary-nameserver>" >&2
  exit 1
fi
PRIMARY_NS="$1"
DUMP_FILE=/var/cache/bind/named_dump.db

rm -f "$DUMP_FILE"
rndc dumpdb -zones

I=0
until [ -f "$DUMP_FILE" ] && tail -1 "$DUMP_FILE" | grep -q -F '; Dump complete'; do
  I=$((I+1))
  if [ $I -gt 10 ]; then
    echo "Timeout waiting for dump to complete." >&2
    exit 1
  fi
  sleep 0.5
done

RET=0
DIG_OUTPUT=$(mktemp)
trap 'rm -f "$DIG_OUTPUT"' EXIT

while read NAME; do
  if ! dig -t NS "$NAME" > "$DIG_OUTPUT" 2>&1 || ! grep -q -F "$PRIMARY_NS." "$DIG_OUTPUT"; then
    echo "$NAME"
    cat "$DIG_OUTPUT"
    RET=1
  fi
done < <(egrep "\s+IN\s+NS\s+$PRIMARY_NS\.?$" "$DUMP_FILE" | awk '{print $1}' | sort -u)

exit $RET
