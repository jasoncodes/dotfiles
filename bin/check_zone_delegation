#!/bin/bash
set -euo pipefail

if [ $# != 1 ]; then
  echo "Usage: `basename $0` <primary-nameserver>" >&2
  exit 1
fi
PRIMARY_NS="$1"
DUMP_FILE=/var/cache/bind/named_dump.db

rm -f "$DUMP_FILE"
rndc dumpdb -zones

I=0
until [ -f "$DUMP_FILE" ] && tail -1 "$DUMP_FILE" | grep -q -F '; Dump complete'; do
  I=$((I+1))
  if [ $I -gt 10 ]; then
    echo "Timeout waiting for dump to complete." >&2
    exit 1
  fi
  sleep 0.5
done

RET=0
DIG_OUTPUT=$(mktemp)
trap 'rm -f "$DIG_OUTPUT"' EXIT

while read NAME; do
  : > "$DIG_OUTPUT"
  for ATTEMPT in 1 2 3; do
    DIG_STATUS=0
    RESPONSE=$(dig -t NS "$NAME" 2>&1) || DIG_STATUS=$?
    printf 'Attempt %s:\n%s\n' "$ATTEMPT" "$RESPONSE" >> "$DIG_OUTPUT"

    # Retry only SERVFAIL; other errors and changed records fail immediately.
    if ! grep -q 'status: SERVFAIL,' <<< "$RESPONSE" || [ "$ATTEMPT" -eq 3 ]; then
      break
    fi
    sleep 2
  done

  if [ "$DIG_STATUS" -ne 0 ] || grep -q 'status: SERVFAIL,' <<< "$RESPONSE" || ! grep -q -F "$PRIMARY_NS." <<< "$RESPONSE"; then
    echo "$NAME"
    cat "$DIG_OUTPUT"
    RET=1
  fi
done < <(egrep "\s+IN\s+NS\s+$PRIMARY_NS\.?$" "$DUMP_FILE" | awk '{print $1}' | sort -u)

exit $RET
