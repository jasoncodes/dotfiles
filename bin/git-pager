#!/bin/bash
set -euo pipefail

usage() {
  cat <<EOF
Usage: $0 [options]

Pages terminal output; passes non-terminal output through unchanged.
Uses git-ultrapager for diffs and commits when available.

  --filter    Apply diff-highlight without paging
  --install   Install git-ultrapager
  -h, --help  Show this help
EOF
}

mode=pager

while [[ $# -gt 0 ]]; do
  case "$1" in
    --filter)
      mode=filter
      ;;
    --install)
      mode=install
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    *)
      printf 'git-pager: unexpected argument: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
  shift
done

if [[ $# -gt 0 ]]; then
  printf 'git-pager: unexpected argument: %s\n' "$1" >&2
  usage >&2
  exit 2
fi

install_ultrapager() {
  PATH="$PATH:$HOME/.cargo/bin"

  if ! command -v cargo >/dev/null; then
    if ! command -v brew >/dev/null; then
      printf 'git-pager: Rust tooling is required; install Cargo or Homebrew first.\n' >&2
      exit 1
    fi

    brew install rust

    if ! command -v cargo >/dev/null; then
      printf 'git-pager: Cargo was not found after installing Rust; add the Rust tooling to PATH.\n' >&2
      exit 1
    fi
  fi

  cargo install --git https://github.com/cryks/git-ultrapager --locked git-ultrapager
}

capture_first() {
  first_newline=
  if IFS= read -r first; then
    first_newline=$'\n'
  elif [[ -z "$first" ]]; then
    exit 0
  fi
  esc=$(printf '\033')
  plain=$(printf '%s\n' "$first" | sed "s/${esc}\[[0-9;:]*m//g")
}

replay() {
  printf '%s%s' "$first" "$first_newline"
  cat
}

pager() {
  PATH="$PATH:$HOME/.cargo/bin"

  case "$plain" in
    diff[[:space:]]*|commit[[:space:]]*)
      if command -v git-ultrapager >/dev/null; then
        exec git-ultrapager
      fi
      printf 'warning: git-ultrapager not found. run `git-pager --install`\n' >&2
      ;;
  esac

  diff-highlight | ${PAGER:-less}
}

case "$mode" in
  install)
    install_ultrapager
    ;;
  filter)
    diff-highlight
    ;;
  pager)
    if [[ ! -t 1 ]]; then
      exec cat
    fi
    capture_first
    replay | pager
    ;;
  *)
    echo "unknown mode: $mode" >&2
    exit 1
    ;;
esac
