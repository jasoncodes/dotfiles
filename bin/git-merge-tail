#!/bin/bash -e

branch=${1:?Usage: git-merge-tail BRANCH BASE_REF}
base_ref=${2:?Usage: git-merge-tail BRANCH BASE_REF}

current_branch="$(git branch --show-current)"
if [ -z "$current_branch" ]; then
  echo "must start on a named branch" >&2
  exit 1
fi

base="$(git rev-parse --verify "$base_ref^{commit}")"
tip="$(git rev-parse HEAD)"

if git show-ref --verify --quiet "refs/heads/$branch"; then
  echo "branch already exists: $branch" >&2
  exit 1
fi

worktree="$(mktemp -d "${TMPDIR:-/tmp}/git-merge-tail.XXXXXX")"
cleanup() {
  git worktree remove --force "$worktree" >/dev/null 2>&1 || true
  git branch -D "$branch" >/dev/null 2>&1 || true
}
trap cleanup EXIT

git branch "$branch" "$tip"
git worktree add --detach "$worktree" "$base"
git -C "$worktree" merge --no-ff -m "Merge branch '$branch'" "$branch"
merge="$(git -C "$worktree" rev-parse HEAD)"

if [ "$(git rev-parse "$tip^{tree}")" != "$(git rev-parse "$merge^{tree}")" ]; then
  echo "merge commit tree differs from current tip" >&2
  exit 1
fi

git reset --soft "$merge"
