#!/bin/bash
set -euo pipefail

SCRIPT_NAME="$(basename "$0")"

if [ $# -lt 2 ]; then
  echo "Usage: $SCRIPT_NAME <primary-mx> <domains...>" >&2
  echo >&2
  echo "Example: $SCRIPT_NAME mx1.example.com \$(find -L /etc/mail/virtual/ -maxdepth 1 -type f -exec basename \{\} \;)"
  exit 1
fi

PRIMARY_MX="$1"
shift

TMP_LOOKUP="$(mktemp "${TMPDIR:-/tmp}/$SCRIPT_NAME.XXXXXX")"
trap '{ rm -f "$TMP_LOOKUP"; }' EXIT

RET=0

for DOMAIN in "$@"; do
  : > "$TMP_LOOKUP"
  for ATTEMPT in 1 2 3; do
    DIG_STATUS=0
    RESPONSE=$(dig -t MX "$DOMAIN" 2>&1) || DIG_STATUS=$?
    printf 'Attempt %s:\n%s\n' "$ATTEMPT" "$RESPONSE" >> "$TMP_LOOKUP"

    # Retry only SERVFAIL; other errors and changed records fail immediately.
    if ! grep -q 'status: SERVFAIL,' <<< "$RESPONSE" || [ "$ATTEMPT" -eq 3 ]; then
      break
    fi
    sleep 2
  done

  if [ "$DIG_STATUS" -ne 0 ] || grep -q 'status: SERVFAIL,' <<< "$RESPONSE" || ! awk '$3 == "IN" && $4 == "MX" { print $5, $6 }' <<< "$RESPONSE" | sort -n | head -1 | grep -q -F "$PRIMARY_MX."; then
    echo "$DOMAIN"
    cat "$TMP_LOOKUP"
    RET=1
  fi
done

exit $RET
